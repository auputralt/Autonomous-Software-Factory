# SECURITY: Never commit the actual .env file.
GEMINI_API_KEY=your-google-gemini-api-key-here

# INFRASTRUCTURE
REDIS_URL=redis://localhost:6379/0

# LIMITS
MAX_BUILD_ATTEMPTS=5
SANDBOX_TIMEOUT_SECS=30
SANDBOX_MAX_MEMORY_MB=512
DAILY_REQUEST_LIMIT=200
DOWNLOAD_DIR=/tmp/forge_builds

# MODELS (Optimized for throughput and cost)
MANAGER_MODEL=gemini-2.0-flash
DEVELOPER_MODEL=gemini-2.0-flash
TESTER_MODEL=gemini-2.0-flash
